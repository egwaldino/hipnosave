{
  "name": "hipnosave",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter shared build && pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  }
}
